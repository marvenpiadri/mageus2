# Neon pooled connection string. Keep credentials server-side and out of Git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
NODE_ENV=development
PORT=3333
CORS_ORIGINS=http://localhost:4200
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_ISSUER=mageus-api
AUTH_AUDIENCE=mageus
# Optional dedicated secret for privacy-preserving anonymous analytics (32+ characters).
ANALYTICS_HASH_SECRET=replace-with-a-different-32-character-secret
# Optional public base URL for the API used by SSR.
MAGEUS_API_URL=http://localhost:3333/api/v1

# Optional social sign-in. Register these exact callback URLs with each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3333/api/v1/auth/oauth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3333/api/v1/auth/oauth/facebook/callback
