# Neon pooled connection string. Keep credentials server-side and out of Git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
NODE_ENV=development
PORT=3333
# Exact frontend origins, comma-separated. Never use * with credentialed requests.
CORS_ORIGINS=http://localhost:4200
# Optional only after an auth issuer is configured. Public article routes do not need it.
AUTH_ISSUER=
AUTH_AUDIENCE=mageus
